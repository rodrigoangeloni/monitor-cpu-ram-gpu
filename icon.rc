#include <windows.h>

// Icon resource (ID 1 for default application icon)
1 ICON "favicon.ico"

// Version Information (Propiedades / Detalles del archivo)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,7,0,0
PRODUCTVERSION  1,7,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RoanDev"
            VALUE "FileDescription",  "Monitor CPU/RAM/GPU"
            VALUE "FileVersion",      "1.7.0.0"
            VALUE "InternalName",     "monitor.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RoanDev"
            VALUE "OriginalFilename", "monitor.exe"
            VALUE "ProductName",      "Monitor CPU/RAM/GPU"
            VALUE "ProductVersion",   "1.7.0.0"
        END
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName",      "RoanDev"
            VALUE "FileDescription",  "Monitor CPU/RAM/GPU"
            VALUE "FileVersion",      "1.7.0.0"
            VALUE "InternalName",     "monitor.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RoanDev"
            VALUE "OriginalFilename", "monitor.exe"
            VALUE "ProductName",      "Monitor CPU/RAM/GPU"
            VALUE "ProductVersion",   "1.7.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0, 0x0c0a, 0x04b0
    END
END
